<script>\
\cf14 /*\
 Sequence built exactly from user's steps:\
 1) Flat, chewing sides of upper teeth \'97 15s each side (right, left)\
 2) Front upper teeth \'97 10s\
 3) Behind the front upper teeth \'97 10s\
 4) Four upper sides \'97 inside two sides, outside two sides \'97 7s per side\
 5) repeat steps for bottom teeth\
*/\cf0 \
\
\cf10 const\cf0  regions = \{\
  \cf14 // upper region element ids\cf0 \
  \cf12 'u-chew-right'\cf0 : \cf11 document\cf0 .\cf15 getElementById\cf0 (\cf12 'u-chew-right'\cf0 ),\
  \cf12 'u-chew-left'\cf0 :  \cf11 document\cf0 .\cf15 getElementById\cf0 (\cf12 'u-chew-left'\cf0 ),\
  \cf12 'u-front'\cf0 :      \cf11 document\cf0 .\cf15 getElementById\cf0 (\cf12 'u-front'\cf0 ),\
  \cf12 'u-behind'\cf0 :     \cf11 document\cf0 .\cf15 getElementById\cf0 (\cf12 'u-behind'\cf0 ),\
  \cf12 'u-in-left'\cf0 :    \cf11 document\cf0 .\cf15 getElementById\cf0 (\cf12 'u-in-left'\cf0 ),\
  \cf12 'u-out-left'\cf0 :   \cf11 document\cf0 .\cf15 getElementById\cf0 (\cf12 'u-out-left'\cf0 ),\
  \cf12 'u-in-right'\cf0 :   \cf11 document\cf0 .\cf15 getElementById\cf0 (\cf12 'u-in-right'\cf0 ),\
  \cf12 'u-out-right'\cf0 :  \cf11 document\cf0 .\cf15 getElementById\cf0 (\cf12 'u-out-right'\cf0 ),\
  \cf14 // lower\cf0 \
  \cf12 'l-chew-right'\cf0 : \cf11 document\cf0 .\cf15 getElementById\cf0 (\cf12 'l-chew-right'\cf0 ),\
  \cf12 'l-chew-left'\cf0 :  \cf11 document\cf0 .\cf15 getElementById\cf0 (\cf12 'l-chew-left'\cf0 ),\
  \cf12 'l-front'\cf0 :      \cf11 document\cf0 .\cf15 getElementById\cf0 (\cf12 'l-front'\cf0 ),\
  \cf12 'l-behind'\cf0 :     \cf11 document\cf0 .\cf15 getElementById\cf0 (\cf12 'l-behind'\cf0 ),\
  \cf12 'l-in-left'\cf0 :    \cf11 document\cf0 .\cf15 getElementById\cf0 (\cf12 'l-in-left'\cf0 ),\
  \cf12 'l-out-left'\cf0 :   \cf11 document\cf0 .\cf15 getElementById\cf0 (\cf12 'l-out-left'\cf0 ),\
  \cf12 'l-in-right'\cf0 :   \cf11 document\cf0 .\cf15 getElementById\cf0 (\cf12 'l-in-right'\cf0 ),\
  \cf12 'l-out-right'\cf0 :  \cf11 document\cf0 .\cf15 getElementById\cf0 (\cf12 'l-out-right'\cf0 ),\
\};\
\
\cf10 function\cf0  \cf15 buildSequenceFor\cf0 (upperOrLowerPrefix) \{\
  \cf14 // prefix "u" or "l"\cf0 \
  \cf10 const\cf0  p = upperOrLowerPrefix;\
  \cf10 return\cf0  [\
    \{ \cf11 label\cf0 :\cf12 `$\{p.toUpperCase()\}\cf0  chewing \'97 Right`, \cf11 duration\cf0 :\cf11 15\cf0 , \cf11 region\cf0 :\cf12 `$\{p\}\cf0 -chew-right` \},\
    \{ \cf11 label\cf0 :\cf12 `$\{p.toUpperCase()\}\cf0  chewing \'97 Left`,  \cf11 duration\cf0 :\cf11 15\cf0 , \cf11 region\cf0 :\cf12 `$\{p\}\cf0 -chew-left` \},\
    \{ \cf11 label\cf0 :\cf12 `$\{p.toUpperCase()\}\cf0  front`,           \cf11 duration\cf0 :\cf11 10\cf0 , \cf11 region\cf0 :\cf12 `$\{p\}\cf0 -front` \},\
    \{ \cf11 label\cf0 :\cf12 `Behind $\{p.toUpperCase()\}\cf0  front`,    \cf11 duration\cf0 :\cf11 10\cf0 , \cf11 region\cf0 :\cf12 `$\{p\}\cf0 -behind` \},\
    \cf14 // four sides: inside two sides, outside two sides \'97 7s each\cf0 \
    \{ \cf11 label\cf0 :\cf12 `$\{p.toUpperCase()\}\cf0  inside \'97 Left`,   \cf11 duration\cf0 :\cf11 7\cf0 , \cf11 region\cf0 :\cf12 `$\{p\}\cf0 -in-left` \},\
    \{ \cf11 label\cf0 :\cf12 `$\{p.toUpperCase()\}\cf0  outside \'97 Left`,  \cf11 duration\cf0 :\cf11 7\cf0 , \cf11 region\cf0 :\cf12 `$\{p\}\cf0 -out-left` \},\
    \{ \cf11 label\cf0 :\cf12 `$\{p.toUpperCase()\}\cf0  inside \'97 Right`,  \cf11 duration\cf0 :\cf11 7\cf0 , \cf11 region\cf0 :\cf12 `$\{p\}\cf0 -in-right` \},\
    \{ \cf11 label\cf0 :\cf12 `$\{p.toUpperCase()\}\cf0  outside \'97 Right`, \cf11 duration\cf0 :\cf11 7\cf0 , \cf11 region\cf0 :\cf12 `$\{p\}\cf0 -out-right` \}\
  ];\
\}\
\
\cf14 // full sequence: upper then lower\cf0 \
\cf10 const\cf0  sequence = [\
  ...\cf15 buildSequenceFor\cf0 (\cf12 'u'\cf0 ),\
  ...\cf15 buildSequenceFor\cf0 (\cf12 'l'\cf0 )\
];\
\
\cf10 let\cf0  state = \{\
  \cf11 idx\cf0 : \cf11 0\cf0 ,\
  \cf11 secondsLeft\cf0 : sequence.length ? sequence[\cf11 0\cf0 ].duration : \cf11 0\cf0 ,\
  \cf11 running\cf0 : \cf10 false\cf0 ,\
  \cf11 ticker\cf0 : \cf10 null\cf0 ,\
\};\
\
\cf10 const\cf0  countdown = \cf11 document\cf0 .\cf15 getElementById\cf0 (\cf12 'countdown'\cf0 );\
\cf10 const\cf0  stepLabel = \cf11 document\cf0 .\cf15 getElementById\cf0 (\cf12 'stepLabel'\cf0 );\
\cf10 const\cf0  stepHint  = \cf11 document\cf0 .\cf15 getElementById\cf0 (\cf12 'stepHint'\cf0 );\
\cf10 const\cf0  progFill  = \cf11 document\cf0 .\cf15 getElementById\cf0 (\cf12 'progFill'\cf0 );\
\
\cf10 function\cf0  \cf15 renderStep\cf0 ()\{\
  \cf14 // clear active classes\cf0 \
  \cf15 Object\cf0 .\cf15 values\cf0 (regions).\cf15 forEach\cf0 (el => el && el.classList.\cf15 remove\cf0 (\cf12 'active'\cf0 ));\
  \cf10 if\cf0 (state.idx >= sequence.length)\{\
    stepLabel.textContent = \cf12 'Done!'\cf0 ;\
    stepHint.textContent = \cf12 'All areas brushed \'97 great job!'\cf0 ;\
    countdown.textContent = \cf12 '0:00'\cf0 ;\
    progFill.style.width = \cf12 '100%'\cf0 ;\
    navigator.vibrate && navigator.\cf15 vibrate\cf0 ([\cf11 80\cf0 ,\cf11 40\cf0 ,\cf11 80\cf0 ]);\
    \cf10 return\cf0 ;\
  \}\
  \cf10 const\cf0  s = sequence[state.idx];\
  stepLabel.textContent = \cf12 `Step $\{state.idx+\cf11 1\cf0 \} \'97 $\{s.label\}`;\
  stepHint.textContent = \cf12 `Brush this area for $\{s.duration\}\cf0  seconds`;\
  countdown.textContent = \cf15 formatTime\cf0 (state.secondsLeft);\
  \cf14 // highlight region\cf0 \
  \cf10 const\cf0  el = regions[s.region];\
  \cf10 if\cf0 (el) el.classList.\cf15 add\cf0 (\cf12 'active'\cf0 );\
  \cf14 // progress percent\cf0 \
  \cf10 const\cf0  percent = \cf15 Math\cf0 .\cf15 round\cf0 ((state.idx / sequence.length) * \cf11 100\cf0 );\
  progFill.style.width = percent + \cf12 '%'\cf0 ;\
\}\
\
\cf10 function\cf0  \cf15 formatTime\cf0 (sec)\{\
  \cf10 const\cf0  mm = \cf15 Math\cf0 .\cf15 floor\cf0 (sec/\cf11 60\cf0 );\
  \cf10 const\cf0  ss = sec % \cf11 60\cf0 ;\
  \cf10 return\cf0  mm + \cf12 ':'\cf0  + (ss<\cf11 10\cf0 ? \cf12 '0'\cf0 +ss : ss);\
\}\
\
